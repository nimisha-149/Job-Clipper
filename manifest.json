{
  "manifest_version": 3,
  "name": "Job Clipper - Internship Tracker",
  "version": "1.0.0",
  "description": "Save job listings from webpages and manage applications on one board.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Clipper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "dashboard.html"
}